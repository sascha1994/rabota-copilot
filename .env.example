# Replace YOUR_EMAIL with your real contact email before collecting vacancies.
HH_USER_AGENT="RabotaCopilot/0.1 (YOUR_EMAIL)"
SEARCH_CONFIG=search.example.json
SQLITE_PATH=data/vacancies.sqlite3

# Telegram: token from BotFather; ADMIN_ID from the bot /id command.
TG_BOT_TOKEN=
ADMIN_ID=

# HH API access token (not the Telegram bot token).
HH_ACCESS_TOKEN=

# Public HTML search; no HH developer registration required.
VACANCY_SOURCE=web
WEB_MAX_PAGES=3

# On-demand OpenAI assessment. Limits are local, per UTC day.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_DAILY_CALL_LIMIT=20
AI_DAILY_TOKEN_LIMIT=200000

# Proxy for OpenAI only. Empty = direct. Examples:
# http://127.0.0.1:8080
# http://user:password@host:port
# socks5://127.0.0.1:1080
OPENAI_PROXY_URL=

# Automatic local SQLite backups; 0 disables. Copies are not pruned automatically.
BACKUP_INTERVAL_HOURS=6
BACKUP_DIR=data/backups

# Real UI submission (requires browser dependencies, saved login and site resume IDs).
APPLICATION_SENDER=none
BROWSER_PROFILE_DIR=data/browser-profile
BROWSER_CHANNEL=chrome
RABOTA_RESUME_WEB_UI=
RABOTA_RESUME_WEB=
RABOTA_RESUME_GRAPHIC=
RABOTA_RESUME_NARRATIVE=
PORTFOLIO_GENERAL=
PORTFOLIO_AI=
PORTFOLIO_GRAPHIC=
PORTFOLIO_MARKETPLACE=
# Set only after explicit consent for the exact countries shown by rabota.by.
RABOTA_FOREIGN_CONSENT=0
